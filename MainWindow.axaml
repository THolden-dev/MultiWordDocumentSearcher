<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WordDocumentSearcher.MainWindow"
        Title="WordDocumentSearcher">

    <Grid RowDefinitions="*, Auto" Background="#F8F8F8">
      
        <Grid Grid.Row="0">
            <ScrollViewer Name="ResultsScrollSection" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <Grid Name="ResultsGrid">
                </Grid>
            </ScrollViewer>
            
            <Grid Name="ViewResultPanel" IsVisible="false" RowDefinitions="Auto, *">
                <Button Content="Back" Click="backButton" Grid.Row="0" Margin="0,0,0,10"/>
                <ScrollViewer Name="ViewResultsScroll" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
                    <Grid Name="ViewResultsGrid">
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,15,0,0">
            <TextBlock Margin="0,5">Search Term:</TextBlock>
            <TextBox Name="SearchTermTextBox" PlaceholderText="Enter search term"/>
            
            <TextBlock Margin="0,5">Abstract character length:</TextBlock>
            <TextBox Name="CharacterLengthTextBox" PlaceholderText="Enter a whole number"/>
            
            <Grid ColumnDefinitions="*,*">
                <Button Content="Search" Click="button_test" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <Button Content="Select Folder" Click="SelectFolderButton" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            </Grid>
        </StackPanel>
        
    </Grid>
</Window>